# Copy this file to .env and fill in your values. .env is git-ignored.
# Real environment variables take precedence over values in this file.

# Your Anthropic API key. Not needed when INCIDENTLY_FAKE_LLM=1, or if you have
# signed in with `ant auth login`. Uncomment and fill in; an empty value would
# hide any other credentials you have set up.
#ANTHROPIC_API_KEY=sk-ant-...

# Model used for every call (default: claude-opus-5-5).
#INCIDENTLY_MODEL=claude-opus-5-5

# Effort per simulated command: low | medium | high | xhigh | max (default: low).
# Raise it if command output feels shallow or inconsistent.
#INCIDENTLY_TURN_EFFORT=low

# Effort for scenario setup and final grading (default: high).
#INCIDENTLY_DEEP_EFFORT=high

# 1 = use the scripted fake model and never call the API (default: 0).
#INCIDENTLY_FAKE_LLM=0

# Retries for rate limits, server errors, and network drops (default: 4).
#INCIDENTLY_API_MAX_RETRIES=4

# Seconds before a single API request times out (default: 120).
#INCIDENTLY_API_TIMEOUT=120
